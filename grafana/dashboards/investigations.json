{
  "uid": "opengrid-investigations",
  "title": "Investigation Queue",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Cases",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "opengrid-mysql"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT id, case_no, entity_code, priority, status, assigned_to, opened_at FROM v_cases ORDER BY priority DESC LIMIT 1000",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open investigation",
                    "url": "http://localhost:8000/investigations/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "transformer",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "opengrid-mysql"
        },
        "query": "SELECT code FROM v_assets WHERE kind='TRANSFORMER' ORDER BY code",
        "refresh": 1
      },
      {
        "name": "meter",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "opengrid-mysql"
        },
        "query": "SELECT code FROM v_assets WHERE kind='METER' ORDER BY code",
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "OpenGrid dashboards",
      "tags": [
        "opengrid"
      ]
    }
  ],
  "tags": [
    "opengrid"
  ]
}
