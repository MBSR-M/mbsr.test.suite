{
  "$defs": {
    "AnomalyType": {
      "enum": [
        "TRANSFORMER_IMBALANCE",
        "TRANSFORMER_DATA_QUALITY",
        "TRANSFORMER_COMMUNICATION",
        "CONSUMPTION_DROP",
        "CONSUMPTION_SPIKE",
        "FLATLINE",
        "ZERO_CONSUMPTION",
        "METER_DATA_QUALITY",
        "METER_COMMUNICATION"
      ],
      "title": "AnomalyType",
      "type": "string"
    },
    "DashboardActivityContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "activity_id": {
          "description": "Stable source-qualified identifier, e.g. anomaly:42, audit:3 or UUID.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Activity Id",
          "type": "string"
        },
        "timestamp": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Timestamp",
          "type": "string"
        },
        "activity_type": {
          "enum": [
            "READING",
            "QUALITY",
            "ANOMALY",
            "COMMUNICATION",
            "INVESTIGATION",
            "SYSTEM"
          ],
          "title": "Activity Type",
          "type": "string"
        },
        "entity_type": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Type"
        },
        "entity_id": {
          "anyOf": [
            {
              "description": "Existing internal numeric database identifier, distinct from operational code.",
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "activity_id",
        "timestamp",
        "activity_type",
        "entity_type",
        "entity_id",
        "title",
        "description",
        "severity"
      ],
      "title": "DashboardActivityContract",
      "type": "object"
    },
    "DashboardContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Generated At",
          "type": "string"
        },
        "filters": {
          "$ref": "#/$defs/DashboardFilterContract"
        },
        "summary": {
          "$ref": "#/$defs/DashboardSummaryContract"
        },
        "trend": {
          "$ref": "#/$defs/DashboardTrendContract"
        },
        "health": {
          "$ref": "#/$defs/DashboardHealthDistributionContract"
        },
        "top_transformers": {
          "items": {
            "$ref": "#/$defs/DashboardTransformerItemContract"
          },
          "maxItems": 50,
          "title": "Top Transformers",
          "type": "array"
        },
        "top_meters": {
          "items": {
            "$ref": "#/$defs/DashboardMeterItemContract"
          },
          "maxItems": 50,
          "title": "Top Meters",
          "type": "array"
        },
        "top_investigations": {
          "items": {
            "$ref": "#/$defs/DashboardInvestigationItemContract"
          },
          "maxItems": 50,
          "title": "Top Investigations",
          "type": "array"
        },
        "data_quality": {
          "$ref": "#/$defs/DashboardDataQualityContract"
        },
        "recent_activity": {
          "items": {
            "$ref": "#/$defs/DashboardActivityContract"
          },
          "maxItems": 100,
          "title": "Recent Activity",
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "filters",
        "summary",
        "trend",
        "health",
        "top_transformers",
        "top_meters",
        "top_investigations",
        "data_quality",
        "recent_activity"
      ],
      "title": "DashboardContract",
      "type": "object"
    },
    "DashboardDataQualityContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "period_start": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Period End",
          "type": "string"
        },
        "completeness_percent": {
          "anyOf": [
            {
              "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
              "ge": 0,
              "le": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completeness Percent"
        },
        "expected_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Intervals"
        },
        "received_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Received Intervals"
        },
        "missing_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Intervals"
        },
        "duplicate_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duplicate Intervals"
        },
        "late_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Late Intervals"
        },
        "invalid_intervals": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Invalid Intervals"
        },
        "affected_meter_count": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Meter Count"
        },
        "affected_transformer_count": {
          "anyOf": [
            {
              "description": "Non-negative count for the stated population and period.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Transformer Count"
        },
        "availability_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability Reason"
        }
      },
      "required": [
        "period_start",
        "period_end",
        "completeness_percent",
        "expected_intervals",
        "received_intervals",
        "missing_intervals",
        "duplicate_intervals",
        "late_intervals",
        "invalid_intervals",
        "affected_meter_count",
        "affected_transformer_count"
      ],
      "title": "DashboardDataQualityContract",
      "type": "object"
    },
    "DashboardFilterContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "from_time": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "From Time",
          "type": "string"
        },
        "to_time": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "To Time",
          "type": "string"
        },
        "feeder_ids": {
          "items": {
            "description": "Existing internal numeric database identifier, distinct from operational code.",
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Feeder Ids",
          "type": "array"
        },
        "transformer_ids": {
          "items": {
            "description": "Existing internal numeric database identifier, distinct from operational code.",
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Transformer Ids",
          "type": "array"
        },
        "severity": {
          "items": {
            "$ref": "#/$defs/Severity"
          },
          "maxItems": 4,
          "title": "Severity",
          "type": "array"
        },
        "granularity": {
          "default": "15m",
          "enum": [
            "15m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        }
      },
      "required": [
        "from_time",
        "to_time"
      ],
      "title": "DashboardFilterContract",
      "type": "object"
    },
    "DashboardHealthDistributionContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "healthy": {
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "Healthy",
          "type": "integer"
        },
        "watch": {
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "Watch",
          "type": "integer"
        },
        "high": {
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "critical": {
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "Critical",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "healthy",
        "watch",
        "high",
        "critical"
      ],
      "title": "DashboardHealthDistributionContract",
      "type": "object"
    },
    "DashboardInvestigationItemContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "investigation_id": {
          "description": "Existing internal numeric database identifier, distinct from operational code.",
          "minimum": 1,
          "title": "Investigation Id",
          "type": "integer"
        },
        "case_no": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Case No",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "entity_id": {
          "description": "Existing internal numeric database identifier, distinct from operational code.",
          "minimum": 1,
          "title": "Entity Id",
          "type": "integer"
        },
        "entity_display_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Entity Display Name",
          "type": "string"
        },
        "priority_score": {
          "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
          "ge": 0,
          "le": 100,
          "title": "Priority Score",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "estimated_unaccounted_kwh": {
          "anyOf": [
            {
              "decimal_places": 6,
              "description": "Signed analytical energy in kWh with up to six fractional digits; aggregate totals may exceed a single DECIMAL(20,6) source row.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Unaccounted Kwh"
        },
        "status": {
          "$ref": "#/$defs/InvestigationStatus"
        },
        "assigned_to": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assigned To"
        },
        "opened_at": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Opened At",
          "type": "string"
        }
      },
      "required": [
        "investigation_id",
        "case_no",
        "entity_type",
        "entity_id",
        "entity_display_name",
        "priority_score",
        "severity",
        "estimated_unaccounted_kwh",
        "status",
        "assigned_to",
        "opened_at"
      ],
      "title": "DashboardInvestigationItemContract",
      "type": "object"
    },
    "DashboardMeterItemContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "meter_id": {
          "description": "Existing internal numeric database identifier, distinct from operational code.",
          "minimum": 1,
          "title": "Meter Id",
          "type": "integer"
        },
        "meter_no": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Meter No",
          "type": "string"
        },
        "transformer_id": {
          "anyOf": [
            {
              "description": "Existing internal numeric database identifier, distinct from operational code.",
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transformer Id"
        },
        "transformer_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transformer Code"
        },
        "anomaly_type": {
          "$ref": "#/$defs/AnomalyType"
        },
        "current_consumption_kwh": {
          "anyOf": [
            {
              "decimal_places": 6,
              "description": "Non-negative energy in kWh, DECIMAL(20,6).",
              "ge": 0,
              "max_digits": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Consumption Kwh"
        },
        "baseline_consumption_kwh": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Consumption Kwh"
        },
        "deviation_percent": {
          "anyOf": [
            {
              "description": "Signed percentage; imbalance and deviations can be negative and are not bounded to [0,100].",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deviation Percent"
        },
        "data_completeness_percent": {
          "anyOf": [
            {
              "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
              "ge": 0,
              "le": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Completeness Percent"
        },
        "anomaly_score": {
          "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
          "ge": 0,
          "le": 100,
          "title": "Anomaly Score",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "last_reading_time": {
          "anyOf": [
            {
              "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Reading Time"
        }
      },
      "required": [
        "meter_id",
        "meter_no",
        "transformer_id",
        "transformer_code",
        "anomaly_type",
        "current_consumption_kwh",
        "baseline_consumption_kwh",
        "deviation_percent",
        "data_completeness_percent",
        "anomaly_score",
        "severity",
        "last_reading_time"
      ],
      "title": "DashboardMeterItemContract",
      "type": "object"
    },
