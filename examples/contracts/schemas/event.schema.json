{
  "$defs": {
    "EntityType": {
      "enum": [
        "METER",
        "TRANSFORMER"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "JsonValue": {},
    "MeterEventType": {
      "enum": [
        "POWER_FAILURE",
        "POWER_RESTORED",
        "COMMUNICATION_FAILURE",
        "COMMUNICATION_RESTORED",
        "REGISTER_RESET",
        "COVER_OPEN",
        "MAGNETIC_FIELD"
      ],
      "title": "MeterEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
