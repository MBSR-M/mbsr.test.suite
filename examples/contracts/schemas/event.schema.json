      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/MeterEventType"
    },
    "source": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Evidence",
      "type": "object"
    }
