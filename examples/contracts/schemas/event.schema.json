      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "entity_id": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
