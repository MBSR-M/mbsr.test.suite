        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "loss_deviation": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss Deviation"
        },
        "persistence": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persistence"
        },
        "data_completeness": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Completeness"
        },
        "consumption_anomaly": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumption Anomaly"
        },
        "event_correlation": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Correlation"
        }
      },
      "title": "ScoreComponentsContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Version of this canonical schema; unsupported versions fail closed.",
      "title": "Schema Version",
      "type": "integer"
    },
    "investigation_id": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
      "title": "Investigation Id",
      "type": "integer"
    },
    "case_no": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Case No",
      "type": "string"
    },
    "entity_type": {
      "$ref": "#/$defs/EntityType"
    },
    "entity_id": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
      "title": "Entity Id",
      "type": "integer"
    },
    "anomaly_id": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
      "title": "Anomaly Id",
      "type": "integer"
    },
    "priority_score": {
      "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
      "ge": 0,
      "le": 100,
      "title": "Priority Score",
      "type": "string"
    },
    "estimated_unaccounted_kwh": {
      "anyOf": [
        {
          "decimal_places": 6,
          "description": "Signed analytical energy in kWh with up to six fractional digits; aggregate totals may exceed a single DECIMAL(20,6) source row.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Estimated Unaccounted Kwh"
    },
    "status": {
      "$ref": "#/$defs/InvestigationStatus"
    },
    "assigned_to": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Assigned To"
    },
    "opened_at": {
      "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
      "title": "Opened At",
      "type": "string"
    },
    "closed_at": {
      "anyOf": [
        {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Closed At"
    },
    "resolution": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resolution"
    },
    "version": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
