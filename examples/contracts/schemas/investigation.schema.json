  "required": [
    "investigation_id",
    "case_no",
    "entity_type",
    "entity_id",
    "anomaly_id",
    "priority_score",
    "estimated_unaccounted_kwh",
    "status",
    "assigned_to",
    "opened_at",
    "closed_at",
    "resolution",
    "version",
    "evidence"
  ],
  "title": "InvestigationContract",
  "type": "object"
}
