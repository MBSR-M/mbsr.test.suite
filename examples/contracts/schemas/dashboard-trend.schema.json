{
  "$defs": {
    "DashboardTrendPointContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "description": "Version of this canonical schema; unsupported versions fail closed.",
          "title": "Schema Version",
          "type": "integer"
        },
        "input_energy_kwh": {
          "anyOf": [
            {
              "decimal_places": 6,
              "description": "Signed analytical energy in kWh with up to six fractional digits; aggregate totals may exceed a single DECIMAL(20,6) source row.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Energy Kwh"
        },
        "downstream_energy_kwh": {
          "anyOf": [
            {
              "decimal_places": 6,
              "description": "Signed analytical energy in kWh with up to six fractional digits; aggregate totals may exceed a single DECIMAL(20,6) source row.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Downstream Energy Kwh"
        },
        "accounting_difference_kwh": {
          "anyOf": [
            {
              "decimal_places": 6,
              "description": "Signed analytical energy in kWh with up to six fractional digits; aggregate totals may exceed a single DECIMAL(20,6) source row.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accounting Difference Kwh"
        },
        "accounting_difference_percent": {
          "anyOf": [
            {
              "description": "Signed percentage; imbalance and deviations can be negative and are not bounded to [0,100].",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accounting Difference Percent"
        },
        "input_energy_source": {
          "$ref": "#/$defs/EnergySource",
          "default": "UNAVAILABLE"
        },
        "downstream_energy_source": {
          "$ref": "#/$defs/EnergySource",
          "default": "UNAVAILABLE"
        },
        "accounting_difference_source": {
          "$ref": "#/$defs/EnergySource",
          "default": "UNAVAILABLE"
        },
        "energy_availability": {
          "$ref": "#/$defs/EnergyAvailability",
          "default": "UNAVAILABLE"
        },
        "energy_basis": {
          "const": "NET_IMPORT",
          "default": "NET_IMPORT",
          "title": "Energy Basis",
          "type": "string"
        },
        "availability_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability Reason"
        },
        "timestamp": {
          "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
          "title": "Timestamp",
          "type": "string"
        },
        "data_completeness_percent": {
          "anyOf": [
            {
              "description": "Percentage or evidence index in [0,100]; never a probability of wrongdoing.",
              "ge": 0,
              "le": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Completeness Percent"
        },
        "anomaly_count": {
          "description": "Non-negative count for the stated population and period.",
          "minimum": 0,
          "title": "Anomaly Count",
          "type": "integer"
        }
      },
      "required": [
        "input_energy_kwh",
        "downstream_energy_kwh",
        "accounting_difference_kwh",
        "accounting_difference_percent",
        "timestamp",
        "data_completeness_percent",
        "anomaly_count"
      ],
      "title": "DashboardTrendPointContract",
      "type": "object"
    },
    "EnergyAvailability": {
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "EnergyAvailability",
      "type": "string"
    },
    "EnergySource": {
      "enum": [
        "MEASURED",
        "DERIVED",
        "ESTIMATED",
        "UNAVAILABLE"
      ],
      "title": "EnergySource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Version of this canonical schema; unsupported versions fail closed.",
      "title": "Schema Version",
      "type": "integer"
    },
    "period_start": {
      "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "description": "UTC ISO-8601 timestamp with explicit offset; JSON normalizes to Z.",
      "title": "Period End",
      "type": "string"
    },
    "granularity": {
      "enum": [
        "15m",
        "1h",
        "1d"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/DashboardTrendPointContract"
      },
      "maxItems": 3000,
      "title": "Points",
      "type": "array"
    }
  },
  "required": [
    "period_start",
    "period_end",
    "granularity",
    "points"
  ],
  "title": "DashboardTrendContract",
  "type": "object"
}
