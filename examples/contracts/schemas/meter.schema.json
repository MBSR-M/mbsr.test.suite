{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Version of this canonical schema; unsupported versions fail closed.",
      "title": "Schema Version",
      "type": "integer"
    },
    "meter_id": {
      "description": "Existing internal numeric database identifier, distinct from operational code.",
      "minimum": 1,
      "title": "Meter Id",
      "type": "integer"
    },
    "meter_no": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Meter No",
      "type": "string"
    },
    "transformer_id": {
      "anyOf": [
        {
          "description": "Existing internal numeric database identifier, distinct from operational code.",
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Transformer Id"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "consumer_type": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumer Type"
    },
    "phase": {
      "anyOf": [
        {
          "enum": [
            "SINGLE_PHASE",
            "THREE_PHASE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase"
    },
    "sanctioned_load_kw": {
      "anyOf": [
        {
          "ge": 0,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sanctioned Load Kw"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    }
  },
  "required": [
    "meter_id",
    "meter_no",
    "transformer_id"
  ],
  "title": "MeterContract",
  "type": "object"
}
